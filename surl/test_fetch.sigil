// Serverless driver for surl/fetch: point fetch at a port nothing is
// listening on (127.0.0.1:1) so connect is refused deterministically,
// and assert fetch surfaces that as an Err. No server, no flakiness.
//
// Also covers two regressions purely with pure-function checks (no
// socket involved, so nothing here is network-flaky):
//
// - the TLS diagnostic must not be collapsed to a generic string
//   (see net_error_to_string in fetch.sigil) — this is what made the
//   "every HTTPS request fails" investigation in
//   docs/fixes/surl-tls-failure-and-dead-insecure-flag.md need a
//   manual repro instead of reading the error message;
// - std.url's default_port(scheme) returns 80 for every scheme
//   (including https), which is the actual root cause behind that
//   investigation — fetch.effective_port corrects an https URL with
//   the unset-port default of 80 to 443, and must leave every other
//   case (explicit non-80 ports, plain http) untouched.
import std.byte_array
import std.http
import std.io
import std.list
import std.mem
import std.net
import std.ordering
import std.result
import std.string
import std.url
import fetch
use std.byte_array.{string_to_bytes};
use std.http.{Request};
use std.io.{IO};
use std.list.{Nil};
use std.mem.{Mem};
use std.net.{TlsError};
use std.result.{Err, Ok};
use std.string.{string_concat, string_compare};
use std.ordering.{Equal};
use std.url.{Url};

fn check_int(label: String, got: Int, want: Int) -> Bool ![IO] {
  match got == want {
    true => {
      perform IO.println(string_concat("PASS: ", label));
      true
    },
    false => {
      perform IO.println(string_concat("FAIL: ", label));
      false
    },
  }
}

fn check_string(label: String, got: String, want: String) -> Bool ![IO] {
  match string_compare(got, want) {
    Equal => {
      perform IO.println(string_concat("PASS: ", label));
      true
    },
    _ => {
      perform IO.println(string_concat("FAIL: ", string_concat(label, string_concat(" got: ", got))));
      false
    },
  }
}

// A TLS handshake failure's message payload must survive unmodified —
// it must not be reduced to a fixed literal (e.g. "TLS error") that
// would hide which of many possible causes actually failed.
fn check_tls_diagnostic_forwarded() -> Bool ![IO] {
  let msg: String = "certificate verify failed: unable to get local issuer certificate";
  check_string("TLS diagnostic forwarded unmodified", fetch.net_error_to_string(TlsError(msg)), msg)
}

fn https_url(port: Int) -> Url ![] {
  Url { scheme: "https", host: "example.com", port: port, path: "/", query: "" }
}

fn http_url(port: Int) -> Url ![] {
  Url { scheme: "http", host: "example.com", port: port, path: "/", query: "" }
}

fn check_port_defaulting() -> Bool ![IO] {
  let implicit_https_ok: Bool = check_int("implicit https port (80, std.url's broken default) corrected to 443", fetch.effective_port(https_url(80)), 443);
  let explicit_https_ok: Bool = check_int("explicit non-80 https port left untouched", fetch.effective_port(https_url(8443)), 8443);
  let http_ok: Bool = check_int("plain http port 80 left untouched", fetch.effective_port(http_url(80)), 80);
  match implicit_https_ok {
    true => match explicit_https_ok {
      true => http_ok,
      false => false,
    },
    false => false,
  }
}

fn main() -> Int ![IO, Net, Mem] {
  let url: Url = Url {
    scheme: "http",
    host: "127.0.0.1",
    port: 1,
    path: "/",
    query: "",
  };
  let req: Request = Request {
    method: "GET",
    url: url,
    headers: Nil,
    body: string_to_bytes(""),
  };
  let refused_ok: Bool = match fetch.fetch(req, false, false) {
    Ok(_) => {
      perform IO.println("FAIL: expected Err connecting to refused port");
      false
    },
    Err(msg) => {
      perform IO.println(string_concat("PASS: refused connect returned Err: ", msg));
      true
    },
  };
  let diagnostic_ok: Bool = check_tls_diagnostic_forwarded();
  let port_ok: Bool = check_port_defaulting();
  match refused_ok {
    true => match diagnostic_ok {
      true => match port_ok {
        true => 0,
        false => 1,
      },
      false => 1,
    },
    false => 1,
  }
}
