// surl/fetch — drive one HTTP/1.1 Request over the wire and return the
// parsed Response. Serialization and status/header parsing are delegated
// to std.http (serialize_request / parse_status_line) exactly as the
// task requires. Deciding *how much* body to read, and de-chunking a
// chunked body, is done here with local, case-insensitive
// Content-Length/Transfer-Encoding lookups (see find_content_length_ci /
// find_transfer_encoding_chunked_ci below) plus std.http's own chunk
// parser (parse_chunked_body) — std.http's find_content_length /
// find_transfer_encoding_chunked, and its higher-level parse_response
// which dispatches through the same header lookups, match header names
// exactly and miss a server that sends lowercase field names, which
// reads as "no framing" and silently drops the body. Those stdlib calls
// carry the ![Mem] effect, so fetch's row is ![Net, Mem] — the literal
// ![Net] from the signature sketch is unsatisfiable while still calling
// the requested std.http helpers (they perform Mem), and a compilable
// signature that actually uses std.http is what the acceptance gate
// (compiles + make test-surl passes) needs.
import std.byte_array
import std.char
import std.http
import std.list
import std.mem
import std.net
import std.ordering
import std.result
import std.string
import std.url
use std.byte_array.{byte_array_concat, byte_array_empty, byte_array_get_opt, byte_array_length, byte_array_slice, byte_array_slice_opt, byte_to_int, string_from_bytes, string_to_bytes};
use std.char.{to_lower_ascii};
use std.http.{Header, Request, Response, find_blank_line, parse_chunked_body, parse_status_line, serialize_request};
use std.list.{Cons, List, Nil};
use std.mem.{Mem};
use std.net.{Closed, Conn, ConnectionRefused, NetError, Other, ResolveFailed, TlsError, close, connect, recv, send};
use std.ordering.{Equal, string_compare};
use std.result.{Err, Ok, Result};
use std.string.{string_chars, string_from_chars, string_split, string_to_int};
use std.url.{Url, parse_url, default_port};

// Render a NetError as a human-readable String for the Result's error arm.
fn net_error_to_string(err: NetError) -> String ![] {
  match err {
    ResolveFailed => "DNS resolution failed",
    ConnectionRefused => "Connection refused",
    TlsError(msg) => msg,
    Closed => "Connection closed",
    Other(msg) => msg,
  }
}

// Find a header value by name (case-sensitive).
fn find_header(headers: List[Header], name: String) -> Option[String] ![] {
  match headers {
    Nil => None,
    Cons(h, rest) => {
      match string_compare(h.name, name) {
        Equal => Some(h.value),
        _ => find_header(rest, name),
      }
    },
  }
}

fn lower_ascii_chars(cs: List[Char]) -> List[Char] ![] {
  match cs {
    Nil => Nil,
    Cons(c, rest) => Cons(to_lower_ascii(c), lower_ascii_chars(rest)),
  }
}

fn lower_ascii(s: String) -> String ![] {
  string_from_chars(lower_ascii_chars(string_chars(s)))
}

// Find a header value by name, case-insensitively. HTTP field names are
// case-insensitive (RFC 9110 §5.1) and the response parser preserves the
// casing the server sent, so match against the ASCII-lowercased name —
// std.http.find_content_length / find_transfer_encoding_chunked match
// "Content-Length" / "Transfer-Encoding" exactly and miss a server that
// sends lowercase field names, which stalls the read waiting for framing
// it already received but didn't recognise.
fn find_header_ci(headers: List[Header], name_lower: String) -> Option[String] ![] {
  match headers {
    Nil => None,
    Cons(h, rest) => match string_compare(lower_ascii(h.name), name_lower) {
      Equal => Some(h.value),
      _ => find_header_ci(rest, name_lower),
    },
  }
}

// Content-Length, found case-insensitively and parsed to an Int.
fn find_content_length_ci(headers: List[Header]) -> Option[Int] ![] {
  match find_header_ci(headers, "content-length") {
    None => None,
    Some(v) => match string_to_int(v) {
      Ok(n) => Some(n),
      Err(_) => None,
    },
  }
}

// Transfer-Encoding: chunked, found case-insensitively. The value token
// is case-insensitive too (RFC 9110 §5.6.2), so lowercase it as well.
fn find_transfer_encoding_chunked_ci(headers: List[Header]) -> Bool ![] {
  match find_header_ci(headers, "transfer-encoding") {
    None => false,
    Some(v) => match string_compare(lower_ascii(v), "chunked") {
      Equal => true,
      _ => false,
    },
  }
}

// Check if a status code is a redirect (3xx).
fn is_redirect(status: Int) -> Bool ![] {
  match status >= 300 {
    true => match status < 400 {
      true => true,
      false => false,
    },
    false => false,
  }
}

// Resolve a relative URL against a base URL.
// If the location is relative (starts with /), construct a URL with the
// base URL's scheme, host, and port, and the location's path and query.
// Otherwise, return None.
fn resolve_relative_url(base_url: Url, location: String) -> Option[Url] ![] {
  match byte_array_get_opt(string_to_bytes(location), 0) {
    None => None,
    Some(b) => match byte_to_int(b) {
      47 => Some(Url {
        scheme: base_url.scheme,
        host: base_url.host,
        port: base_url.port,
        path: location,
        query: "",
      }),
      _ => None,
    },
  }
}

// Length of a ByteArray, found by scanning to the first absent index.
// Avoids depending on a byte_array_length helper that the proven repo
// code (surl/base64.sigil) does not use; the scan mirrors that file's
// get_opt/None termination pattern.
fn byte_len(data: ByteArray, pos: Int) -> Int ![] {
  match byte_array_get_opt(data, pos) {
    None => pos,
    Some(_) => byte_len(data, pos + 1),
  }
}

// Send the whole buffer, looping on short writes (std.net.send may write
// fewer than requested bytes); return Err on a stalled (zero-byte) write.
fn send_all_loop(conn: Conn, data: ByteArray, pos: Int, total: Int) -> Result[Unit, NetError] ![Net] {
  match pos >= total {
    true => Ok(()),
    false => match byte_array_slice_opt(data, pos, total) {
      None => Err(Other("send slice out of bounds")),
      Some(chunk) => match send(conn, chunk) {
        Err(e) => Err(e),
        Ok(n) => match n > 0 {
          true => send_all_loop(conn, data, pos + n, total),
          false => Err(Other("zero bytes sent")),
        },
      },
    },
  }
}

fn send_all(conn: Conn, data: ByteArray) -> Result[Unit, NetError] ![Net] {
  send_all_loop(conn, data, 0, byte_len(data, 0))
}

// Extract the HTTP version token (e.g. "HTTP/1.0") from the first word
// of the raw response bytes by scanning for the first space.
fn extract_http_version(raw: ByteArray, pos: Int) -> String ![] {
  match byte_array_get_opt(raw, pos) {
    None => "HTTP/1.1",
    Some(b) => match byte_to_int(b) {
      32 => match byte_array_slice_opt(raw, 0, pos) {
        None => "HTTP/1.1",
        Some(slice) => match string_from_bytes(slice) {
          None => "HTTP/1.1",
          Some(s) => s,
        },
      },
      _ => extract_http_version(raw, pos + 1),
    },
  }
}

// Parse a HEAD response: only status line + headers, no body.
// HEAD responses may carry Content-Length but send no body bytes,
// so parse_response (which validates body length) would error.
fn parse_head_response(raw: ByteArray) -> Result[Response, String] ![Mem] {
  match string_from_bytes(raw) {
    None => Err("non-UTF-8 in HEAD response"),
    Some(raw_str) => {
      let sections: List[String] = string_split(raw_str, "\r\n\r\n");
      match sections {
        Nil => Err("empty HEAD response"),
        Cons(header_section, _) => {
          let lines: List[String] = string_split(header_section, "\r\n");
          match lines {
            Nil => Err("no lines in HEAD response"),
            Cons(status_line, header_lines) => parse_status_line(status_line, header_lines),
          }
        },
      }
    },
  }
}

// Read from the connection, accumulating chunks onto `acc`, until the
// blank-line CRLFCRLF terminator std.http.find_blank_line looks for is
// present. Returns the accumulated bytes (headers plus whatever body
// prefix happened to arrive in the same reads) and the blank-line
// position, or an error if the peer closes before headers are complete.
// This is the piece the old recv_all-to-EOF strategy lacked: it lets the
// caller stop reading as soon as it knows enough to apply the response's
// own framing, instead of waiting for the peer to hang up.
fn recv_headers(conn: Conn, acc: ByteArray) -> Result[(ByteArray, Int), String] ![Net, Mem] {
  match find_blank_line(acc) {
    -1 => match recv(conn, 65536) {
      Err(e) => Err(net_error_to_string(e)),
      Ok(chunk) => match byte_array_length(chunk) == 0 {
        true => Err("connection closed before response headers were complete"),
        false => recv_headers(conn, byte_array_concat(acc, chunk)),
      },
    },
    blank_pos => Ok((acc, blank_pos)),
  }
}

// Keep reading until `acc` holds at least `target` bytes (headers plus a
// full Content-Length body), or the peer closes early.
fn recv_until_length(conn: Conn, acc: ByteArray, target: Int) -> Result[ByteArray, String] ![Net] {
  match byte_array_length(acc) >= target {
    true => Ok(acc),
    false => match recv(conn, 65536) {
      Err(e) => Err(net_error_to_string(e)),
      Ok(chunk) => match byte_array_length(chunk) == 0 {
        true => Err("connection closed before Content-Length body was complete"),
        false => recv_until_length(conn, byte_array_concat(acc, chunk), target),
      },
    },
  }
}

// Keep reading until std.http's own chunk parser can reassemble a full,
// de-chunked body from `body_start` onward (it returns Err while the
// terminating zero-length chunk hasn't arrived yet), or the peer closes
// early. Returns the raw (still chunk-framed) accumulated bytes, plus
// the de-chunked body std.http already produced while checking
// completeness — reused by the caller instead of re-deriving it.
fn recv_until_chunked_complete(conn: Conn, acc: ByteArray, body_start: Int) -> Result[(ByteArray, ByteArray), String] ![Net, Mem] {
  match parse_chunked_body(acc, body_start) {
    Ok(body) => Ok((acc, body)),
    Err(_) => match recv(conn, 65536) {
      Err(e) => Err(net_error_to_string(e)),
      Ok(chunk) => match byte_array_length(chunk) == 0 {
        true => Err("connection closed before chunked body was complete"),
        false => recv_until_chunked_complete(conn, byte_array_concat(acc, chunk), body_start),
      },
    },
  }
}

// Read to end-of-connection: the legitimate fallback when the response
// carries neither Content-Length nor Transfer-Encoding: chunked, so the
// peer closing is the only signal the body is complete.
fn recv_to_eof(conn: Conn, acc: ByteArray) -> Result[ByteArray, String] ![Net] {
  match recv(conn, 65536) {
    Err(e) => Err(net_error_to_string(e)),
    Ok(chunk) => match byte_array_length(chunk) == 0 {
      true => Ok(acc),
      false => recv_to_eof(conn, byte_array_concat(acc, chunk)),
    },
  }
}

// Read and assemble the response body for a non-HEAD request, honouring
// whichever framing the already-parsed headers declare. head_resp already
// carries the parsed status/reason/headers (from parse_head_response), so
// each branch below only needs to supply the body bytes; std.http's own
// chunk parser (parse_chunked_body) is reused for de-chunking rather than
// re-implementing it, and Content-Length/close-delimited bodies are plain
// slices of the accumulated bytes. This does not re-dispatch through
// std.http.parse_response for the framing decision, because that
// dispatch is exactly as case-sensitive about Content-Length /
// Transfer-Encoding as std.http.find_content_length /
// find_transfer_encoding_chunked are (see find_content_length_ci /
// find_transfer_encoding_chunked_ci above) — reusing it here would
// silently re-lose the lowercase-header fix by re-deciding "no framing
// present" a second time and returning an empty body.
fn fetch_body(conn: Conn, head_resp: Response, acc: ByteArray, body_start: Int) -> Result[Response, String] ![Net, Mem] {
  match find_transfer_encoding_chunked_ci(head_resp.headers) {
    true => match recv_until_chunked_complete(conn, acc, body_start) {
      Err(e) => Err(e),
      Ok((_, body)) => Ok(Response {
        status: head_resp.status,
        reason: head_resp.reason,
        headers: head_resp.headers,
        body: body,
      }),
    },
    false => match find_content_length_ci(head_resp.headers) {
      Some(len) => match recv_until_length(conn, acc, body_start + len) {
        Err(e) => Err(e),
        Ok(full) => Ok(Response {
          status: head_resp.status,
          reason: head_resp.reason,
          headers: head_resp.headers,
          body: byte_array_slice(full, body_start, body_start + len),
        }),
      },
      None => match recv_to_eof(conn, acc) {
        Err(e) => Err(e),
        Ok(full) => Ok(Response {
          status: head_resp.status,
          reason: head_resp.reason,
          headers: head_resp.headers,
          body: byte_array_slice(full, body_start, byte_array_length(full)),
        }),
      },
    },
  }
}

// fetch_single: connect, send the serialized request, read only as much of
// the response as its own framing requires, close, and return the HTTP
// version plus the parsed Response. The connection is closed on every
// exit path. Net/parse errors are surfaced as a String. Pass head=true
// for HEAD requests: the read stops once headers are buffered and
// parse_head_response is used instead of parse_response, since a HEAD
// response may advertise a non-zero Content-Length while sending no body.
fn fetch_single(req: Request, head: Bool) -> Result[(String, Response), String] ![Net, Mem] {
  let tls: Bool = match string_compare(req.url.scheme, "https") {
    Equal => true,
    _ => false,
  };
  match connect(req.url.host, req.url.port, tls) {
    Err(e) => Err(net_error_to_string(e)),
    Ok(conn) => {
      let payload: ByteArray = serialize_request(req);
      match send_all(conn, payload) {
        Err(e) => {
          let _: Result[Unit, NetError] = close(conn);
          Err(net_error_to_string(e))
        },
        Ok(_) => {
          let result: Result[(String, Response), String] = match recv_headers(conn, byte_array_empty()) {
            Err(e) => Err(e),
            Ok((acc, blank_pos)) => {
              let version: String = extract_http_version(acc, 0);
              let body_start: Int = blank_pos + 4;
              let header_bytes: ByteArray = byte_array_slice(acc, 0, body_start);
              match parse_head_response(header_bytes) {
                Err(e) => Err(e),
                Ok(head_resp) => match head {
                  true => Ok((version, head_resp)),
                  false => match fetch_body(conn, head_resp, acc, body_start) {
                    Err(e) => Err(e),
                    Ok(resp) => Ok((version, resp)),
                  },
                },
              }
            },
          };
          let _: Result[Unit, NetError] = close(conn);
          result
        },
      }
    },
  }
}

// fetch_with_redirects: recursively follow redirects up to max_hops.
// If follow is false, return the first response (even if 3xx).
// If follow is true and the response is 3xx with a Location header,
// parse the new URL and fetch again (up to ~10 hops).
fn fetch_with_redirects(req: Request, head: Bool, follow: Bool, hops: Int) -> Result[(String, Response), String] ![Net, Mem] {
  match hops <= 0 {
    true => Err("too many redirects"),
    false => match fetch_single(req, head) {
      Err(e) => Err(e),
      Ok((version, resp)) => {
        match follow {
          false => Ok((version, resp)),
          true => match is_redirect(resp.status) {
            false => Ok((version, resp)),
            true => match find_header(resp.headers, "Location") {
              None => Ok((version, resp)),
              Some(location) => match parse_url(location) {
                Ok(new_url) => {
                  let abs_req: Request = Request {
                    method: "GET",
                    url: new_url,
                    headers: Cons(Header { name: "Host", value: new_url.host }, Nil),
                    body: string_to_bytes(""),
                  };
                  fetch_with_redirects(abs_req, head, follow, hops - 1)
                },
                Err(_) => match resolve_relative_url(req.url, location) {
                  None => Err("invalid Location header"),
                  Some(new_url) => {
                    let rel_req: Request = Request {
                      method: "GET",
                      url: new_url,
                      headers: Cons(Header { name: "Host", value: new_url.host }, Nil),
                      body: string_to_bytes(""),
                    };
                    fetch_with_redirects(rel_req, head, follow, hops - 1)
                  },
                },
              },
            },
          },
        }
      },
    },
  }
}

// fetch: wrapper around fetch_with_redirects with a default hop limit of 10.
fn fetch(req: Request, head: Bool, follow: Bool) -> Result[(String, Response), String] ![Net, Mem] {
  fetch_with_redirects(req, head, follow, 10)
}
