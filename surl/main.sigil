import std.env
import std.http
import std.int
import std.io
import std.byte_array
import std.list
import std.mem
import std.net
import std.ordering
import std.string
import args
import request
import fetch

use std.env.{env_args, Env};
use std.http.{Header, Response};
use std.int.{int_to_string};
use std.io.{IO};
use std.byte_array.{byte_to_int, string_from_bytes};
use std.list.{Cons, List, Nil};
use std.mem.{Mem};
use std.net.{Net};
use std.ordering.{Equal};
use std.string.{string_byte_at_opt, string_compare, string_concat};
use args.{parse_args};
use request.{build_request};
use fetch.{fetch};

fn print_headers(headers: List[Header]) -> Unit ![IO] {
  match headers {
    Nil => (),
    Cons(h, rest) => {
      perform IO.println(string_concat(h.name, string_concat(": ", h.value)));
      print_headers(rest)
    },
  }
}

// Fold ASCII uppercase (65-90) down to lowercase so header-name comparison
// is case-insensitive, since HTTP field names are case-insensitive but
// std.http preserves the casing the server actually sent.
fn ascii_lower_byte(n: Int) -> Int ![] {
  match n >= 65 {
    true => match n <= 90 {
      true => n + 32,
      false => n,
    },
    false => n,
  }
}

fn string_ci_equal_from(a: String, b: String, i: Int) -> Bool ![] {
  match string_byte_at_opt(a, i) {
    None => match string_byte_at_opt(b, i) {
      None => true,
      Some(_) => false,
    },
    Some(ba) => match string_byte_at_opt(b, i) {
      None => false,
      Some(bb) => match ascii_lower_byte(byte_to_int(ba)) == ascii_lower_byte(byte_to_int(bb)) {
        true => string_ci_equal_from(a, b, i + 1),
        false => false,
      },
    },
  }
}

fn string_ci_equal(a: String, b: String) -> Bool ![] {
  string_ci_equal_from(a, b, 0)
}

fn find_set_cookie_headers(headers: List[Header]) -> List[String] ![] {
  match headers {
    Nil => Nil,
    Cons(h, rest) => {
      match string_ci_equal(h.name, "Set-Cookie") {
        true => Cons(h.value, find_set_cookie_headers(rest)),
        false => find_set_cookie_headers(rest),
      }
    },
  }
}

fn join_lines(strs: List[String]) -> String ![] {
  match strs {
    Nil => "",
    Cons(h, t) => {
      match t {
        Nil => h,
        _ => string_concat(h, string_concat("\n", join_lines(t))),
      }
    },
  }
}

// Write each Set-Cookie header's value to the jar file, one per line.
// No-op when cookie_jar is empty (i.e. -c was not passed). Uses the raw
// builtin Fs effect directly (see the -o write below) rather than
// importing std.fs, to avoid the FsError.Other / NetError.Other E0118
// collision that importing std.fs would cause alongside std.net.
fn write_cookies_to_jar(cookie_jar: String, resp: Response) -> Unit ![Fs] {
  match string_compare(cookie_jar, "") {
    Equal => (),
    _ => {
      let cookies: List[String] = find_set_cookie_headers(resp.headers);
      let cookie_data: String = join_lines(cookies);
      match perform Fs.write_file(cookie_jar, cookie_data) {
        (0, _) => (),
        (_, _) => (),
      }
    },
  }
}

fn main() -> Int ![IO, Env, Net, Mem, Fs] {
  let argv: List[String] = env_args();
  match parse_args(argv) {
    Err(usage_msg) => {
      perform IO.println(usage_msg);
      0
    },
    Ok(config) => {
      match build_request(config) {
        Err(err_msg) => {
          perform IO.println(err_msg);
          1
        },
        Ok(req) => {
          match fetch(req, config.head_only, config.follow) {
            Err(err_msg) => {
              perform IO.println(err_msg);
              1
            },
            Ok((version, resp)) => {
              let _: Unit = write_cookies_to_jar(config.cookie_jar, resp);
              match config.head_only {
                true => {
                  let status_line: String = string_concat(version, string_concat(" ", string_concat(int_to_string(resp.status), string_concat(" ", resp.reason))));
                  perform IO.println(status_line);
                  print_headers(resp.headers);
                  0
                },
                false => {
                  match string_from_bytes(resp.body) {
                    None => {
                      perform IO.println("Error: invalid UTF-8 in response body");
                      1
                    },
                    Some(body_str) => {
                      match string_compare(config.output, "") {
                        Equal => {
                          // Emit the response body to stdout and terminate
                          // the line. std.io only exposes println (plain
                          // print is line-buffered with no flush at exit on
                          // the pinned toolchain). The oracle accounts for
                          // the single trailing newline.
                          perform IO.println(body_str);
                          0
                        },
                        _ => {
                          // Write body to file via the builtin Fs effect
                          // directly. Fs is a builtin (no import needed),
                          // so this avoids the FsError.Other / NetError.Other
                          // E0118 collision that importing std.fs would cause.
                          // The raw op returns (Int, String): 0 = success.
                          match perform Fs.write_file(config.output, body_str) {
                            (0, _) => 0,
                            (_, _) => {
                              perform IO.println("Error: could not write to file");
                              1
                            },
                          }
                        },
                      }
                    },
                  }
                },
              }
            },
          }
        },
      }
    },
  }
}
